      function renderCart() {
        var list = document.getElementById("cart-items-list");
        var subtotal = 0;
        var count = 0;

        list.innerHTML = cart.map(function (item, idx) {
          var line = item.price * item.qty;
          subtotal += line;
          count += item.qty;
          return '<div class="py-md flex flex-col sm:flex-row sm:items-center gap-md">' +
            '<img src="' + item.img + '" alt="' + item.name + '" class="w-20 h-20 rounded object-cover bg-light-surface-container-low shrink-0">' +
            '<div class="flex-1">' +
              '<p class="font-title text-title-md text-light-on-surface">' + item.name + '</p>' +
              '<p class="font-body text-body-sm text-light-on-surface-variant">' + item.pack + ' • Unit: AED ' + item.price.toFixed(2) + ' (Demo)</p>' +
            '</div>' +
            '<div class="flex items-center gap-md">' +
              '<div class="inline-flex items-center border border-light-outline-variant rounded px-1">' +
                '<button type="button" data-dec="' + idx + '" class="w-7 h-8">-</button>' +
                '<span class="w-8 text-center font-title text-title-sm tabular-nums">' + item.qty + '</span>' +
                '<button type="button" data-inc="' + idx + '" class="w-7 h-8">+</button>' +
              '</div>' +
              '<span class="w-24 text-right font-title text-title-md text-light-secondary tabular-nums">AED ' + line.toFixed(2) + '</span>' +
              '<button type="button" data-del="' + idx + '" aria-label="Remove item" class="text-light-on-surface-variant hover:text-light-error"><span class="material-symbols-outlined text-[18px]">delete</span></button>' +
            '</div>' +
          '</div>';
        }).join("") || '<p class="py-lg font-body text-body-md text-light-on-surface-variant">Your cart is empty.</p>';

        var shipping = cart.length ? 25 : 0;
        var vat = (subtotal + shipping) * 0.05;
        var total = subtotal + shipping + vat;

        document.getElementById("cart-item-count").textContent = String(count);
        document.getElementById("summary-subtotal").textContent = "AED " + subtotal.toFixed(2);
        document.getElementById("summary-vat").textContent = "AED " + vat.toFixed(2);
        document.getElementById("summary-total").textContent = "AED " + total.toFixed(2);
      }

      document.getElementById("cart-items-list").addEventListener("click", function (e) {
        var dec = e.target.closest("[data-dec]");
        var inc = e.target.closest("[data-inc]");
        var del = e.target.closest("[data-del]");
        if (dec) {
          var i = Number(dec.getAttribute("data-dec"));
          if (cart[i].qty > 1) cart[i].qty -= 1;
          renderCart();
        } else if (inc) {
          var j = Number(inc.getAttribute("data-inc"));
          cart[j].qty += 1;
          renderCart();
        } else if (del) {
          var k = Number(del.getAttribute("data-del"));
          cart.splice(k, 1);
          renderCart();
        }
      });

      document.getElementById("checkout-form").addEventListener("submit", function (e) {
        e.preventDefault();
        document.getElementById("order-success").classList.remove("hidden");
      });

      renderCart();
    })();
  </script>


